#!/usr/bin/env python3
"""amnezia-mesh CLI entrypoint — runs straight from the git checkout,
no installation needed (python >= 3.8, stdlib only)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from awg_mesh.cli import main

if __name__ == "__main__":
    sys.exit(main())
